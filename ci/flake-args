#!/usr/bin/env bash
# Print the nix flags that let the flake evaluate without the local `nixos` input.
#
# The flags replace `nixos` with ci/nixos-stub, and pin `nixpkgs` to the revision
# that flake.lock records for nixos/nixpkgs. The result uses the same nixpkgs as a
# local build, so the derivations are identical.
#
# Usage: nix build $(ci/flake-args) .#checks.x86_64-linux.nixos
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
lock="$root/flake.lock"

node="$(jq -r '.nodes.root.inputs.nixpkgs | if type == "array" then .[0] else . end' "$lock")"
if [ "$node" = "nixos" ]; then
  node="$(jq -r '.nodes.nixos.inputs.nixpkgs' "$lock")"
fi
locked="$(jq -c --arg n "$node" '.nodes[$n].locked' "$lock")"
type="$(jq -r .type <<<"$locked")"
if [ "$type" != "github" ]; then
  echo "ci/flake-args: nixpkgs is locked as type $type. Only github is supported." >&2
  exit 1
fi
ref="github:$(jq -r '"\(.owner)/\(.repo)/\(.rev)"' <<<"$locked")"

printf '%s\n' --override-input nixos "path:$root/ci/nixos-stub" --override-input nixpkgs "$ref"
